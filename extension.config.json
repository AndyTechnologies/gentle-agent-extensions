{
  "sourceDirs": {
    "agents": "resources/agents",
    "overlays": "resources/overlays",
    "routing": "resources/routing",
    "skills": "resources/skills",
    "mcp": "resources/mcp"
  },
  "manifestPath": ".manifest.json",
  "features": {
    "autoSync": true,
    "mcpHealthCheck": false,
    "versionTracking": true,
    "interactiveConflicts": false
  },
  "validation": {
    "requireLicense": true,
    "requireMetadata": false,
    "allowUnknownTargets": true
  },
  "mcpDefaults": {
    "timeout": 60,
    "exposure": "codemode"
  }
}